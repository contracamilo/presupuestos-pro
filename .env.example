# Copia este archivo como .env y ajusta los valores. El archivo .env NO se versiona.

# Dominio público de la instalación. Con "localhost", Caddy usa un certificado local de pruebas.
DOMINIO=localhost

# Ruta del archivo de datos SQLite dentro del contenedor.
RUTA_BD=/datos/presupuestos.db

# 1 = la cookie de sesión solo viaja por HTTPS (obligatorio en producción).
COOKIE_SEGURA=1
